{
  "manifest_version": 3,
  "name": "My Work — Chamados e anotações",
  "version": "2.0.0",
  "description": "Seu My Work no painel lateral do Chrome, conectado ao site e aos mesmos dados.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://meus-chamados-robson-041126.nosborx-costa.chatgpt.site/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir My Work"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}
